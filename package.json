{
  "name": "@serdardb/context-bridge",
  "version": "0.13.0",
  "description": "Seamless bidirectional context bridge between coding agents. Switch agents. Not context.",
  "type": "module",
  "exports": {
    "./adapter-sdk": "./src/adapter-sdk.mjs",
    "./experimental/aider": "./src/experimental/aider.mjs",
    "./experimental/pi": "./src/experimental/pi.mjs",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "bridge": "bin/bridge.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/",
    "codex/",
    ".claude-plugin/",
    "docs/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "test:global": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "test:package": "node test/integration/package-install.mjs",
    "check": "find src bin test packages -name '*.mjs' -not -path '*/node_modules/*' -print -exec node --check {} \\;",
    "eval": "node bin/bridge.mjs eval --json",
    "prepublishOnly": "node bin/bridge.mjs release-check --evidence --json"
  },
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SerdarDB/context-bridge.git"
  },
  "license": "MIT",
  "author": "SerdarDB",
  "homepage": "https://dogrubakar.com/projects/context-bridge",
  "bugs": {
    "url": "https://github.com/SerdarDB/context-bridge/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "antigravity",
    "ai-agents",
    "coding-agents",
    "context",
    "session",
    "bridge",
    "cli",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "koffi": "3.3.0"
  },
  "devDependencies": {
    "@serdardb/context-bridge-mcp": "file:packages/mcp",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5",
    "yaml": "2.9.1"
  }
}
