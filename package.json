{
  "name": "@serdardb/context-bridge",
  "version": "0.12.3",
  "description": "Seamless bidirectional context bridge between coding agents. Switch agents. Not context.",
  "type": "module",
  "bin": {
    "bridge": "bin/bridge.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/",
    "codex/",
    ".claude-plugin/",
    "docs/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "find src bin test -name '*.mjs' -print -exec node --check {} \\;",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SerdarDB/context-bridge.git"
  },
  "license": "MIT",
  "author": "SerdarDB",
  "homepage": "https://dogrubakar.com/projects/context-bridge",
  "bugs": {
    "url": "https://github.com/SerdarDB/context-bridge/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "antigravity",
    "ai-agents",
    "coding-agents",
    "context",
    "session",
    "bridge",
    "cli",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
